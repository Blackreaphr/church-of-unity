RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
RewriteRule ^ / [R=301,L]


# 2) Directory slash normalization
# If the request maps to a *real directory* but lacks a trailing slash, add it.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# For a directory request with a slash, serve its index.html explicitly if present.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*/)$ $1index.html [L]

# 3) App-specific virtual subroutes (serve the shell page)

# Forum URL normalization
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^forum-feed/(.*)$ /forum-feed.html [L]

# Direct forum root to the forum page when there's no folder index
RewriteRule ^forum/?$ /forum.html [L]

# 4) Explicit fallbacks for key routes (prefer folder index, else .html)
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(start-here|practice|texts-library|inquiry-forum)/?$ /$1/index.html [L]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(start-here|practice|texts-library|inquiry-forum)/?$ /$1.html [L]

# Forum subsections
RewriteRule ^forum/welcome/?$ /forum-start/ [R=301,L]
RewriteRule ^forum/guidelines/?$ /forum-guidelines/ [R=301,L]
RewriteRule ^forum/help/?$ /forum-help/ [R=301,L]
RewriteRule ^forum/announcements/?$ /forum-announcements/ [R=301,L]
RewriteRule ^forum/prayer-and-reflections/?$ /forum-prayer-and-reflections/ [R=301,L]
# Printable guides
RewriteRule ^guides/(examen|lectio-divina|rule-of-life)/?$ /guide-$1/ [R=301,L]
# 4b) If a directory exists but lacks an index.html, serve the sibling .html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/$ /$1.html [L]

# 5) Serve existing files/dirs as-is (short-circuit early)
RewriteCond %{REQUEST_FILENAME} -f [OR]
