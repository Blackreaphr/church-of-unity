# Basic setup
RewriteEngine On
Options -MultiViews
DirectoryIndex index.html

# MIME overrides
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# 0a) Asset path normalization and favicon alias
RewriteCond %{REQUEST_URI} ^/.+/assets/
RewriteRule ^(.+)/assets/(.*)$ /assets/$2 [L]

RewriteRule ^(.*/)?assets/symbol\.png$ /assets/symbol.svg [L]
RewriteRule ^favicon\.ico$ /assets/symbol.svg [L]
RewriteRule ^favicon\.png$ /assets/symbol.svg [L]

# 0) Canonical host: force one hostname (choose the one you actually use)
# If your canonical is www:
RewriteCond %{HTTP_HOST} !^www\.thechurchofunity\.com$ [NC]
RewriteRule ^ https://www.thechurchofunity.com%{REQUEST_URI} [R=301,L]

